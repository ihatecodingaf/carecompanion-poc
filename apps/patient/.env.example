# Copy to .env.dev / .env.qa / .env.production and fill in values

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# demo  → uses mock AI analysis (no Anthropic key needed)
# pilot → uses real Claude Vision
VITE_APP_MODE=demo

# Supabase schema slug (org_{slug} maps to the DB schema)
VITE_ORG_SLUG=care_demo
