{
  "name": "care-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Care.ai — AI-powered remote patient monitoring PWA",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:patient": "pnpm --filter @care-ai/patient dev",
    "dev:dashboard": "pnpm --filter @care-ai/dashboard dev",
    "dev:doctor": "pnpm --filter @care-ai/doctor dev",
    "dev:admin": "pnpm --filter @care-ai/admin dev",
    "build": "pnpm --filter @care-ai/shared build && pnpm --parallel --filter=!@care-ai/shared build",
    "build:patient": "pnpm --filter @care-ai/patient build",
    "build:dashboard": "pnpm --filter @care-ai/dashboard build",
    "build:doctor": "pnpm --filter @care-ai/doctor build",
    "build:admin": "pnpm --filter @care-ai/admin build",
    "install:all": "pnpm install"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.33.4"
}
